---
import { commentConfig } from "@/config";

interface Props {
	path: string;
}
const { path } = Astro.props;
const giscus = commentConfig.giscus;
if (!giscus) throw new Error("Giscus comments are not configured");
const config = {
	repo: giscus.repo,
	"repo-id": giscus.repoId,
	category: giscus.category,
	"category-id": giscus.categoryId,
	mapping: giscus.mapping,
	term: path,
	strict: giscus.strict,
	"reactions-enabled": giscus.reactionsEnabled,
	"emit-metadata": giscus.emitMetadata,
	"input-position": giscus.inputPosition,
	lang: giscus.lang,
	loading: giscus.loading,
};
---

<div id="giscus-comments" class="giscus" data-config={JSON.stringify(config)}></div>
<p class="mt-4 text-sm text-(--content-meta)">
  评论需要 GitHub 登录；如果加载失败，也可以
  <a class="underline text-(--primary)" href={`https://github.com/${giscus.repo}/discussions`} target="_blank" rel="noopener noreferrer">前往 GitHub 讨论</a>。
</p>

<script is:inline>
  // 使用官方脚本，不经过第三方模块 CDN；切换文章时重新挂载，清理旧主题监听。
  (() => {
    const container = document.getElementById("giscus-comments");
    if (!container || container.querySelector("script")) return;
    const getTheme = () => document.documentElement.classList.contains("dark") ? "dark_dimmed" : "light";
    const script = document.createElement("script");
    script.src = "https://giscus.app/client.js";
    script.async = true;
    script.crossOrigin = "anonymous";
    const config = JSON.parse(container.dataset.config);
    // 动态页内嵌评论仍按单条动态归属；普通文章不允许查询参数改变评论归属。
    const requestedPath = new URLSearchParams(location.search).get("path");
    if (config.term === "/dynamic/" && requestedPath?.startsWith("/dynamic/") && requestedPath.length <= 512) {
      config.term = requestedPath;
    }
    for (const [name, value] of Object.entries(config)) {
      script.setAttribute(`data-${name}`, value);
    }
    script.setAttribute("data-theme", getTheme());
    container.appendChild(script);

    window.giscusThemeObserver?.disconnect();
    window.giscusThemeObserver = new MutationObserver(() => {
      container.querySelector("iframe")?.contentWindow?.postMessage({ giscus: { setConfig: { theme: getTheme() } } }, "https://giscus.app");
    });
    window.giscusThemeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
  })();
</script>
